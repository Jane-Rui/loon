#!name=中国移动自动签到
#!desc=打开中国移动 APP 自动监听抓包、自动提取 Cookie/UID/手机号、立即触发签到与话费流量查询（无定时任务，无需手动输入任何参数）。
#!author=Jane-Rui
#!icon=https://raw.githubusercontent.com/Jane-Rui/loon/main/Icon/App/10086.png
#!tag=签到,中国移动
#!system=iOS
#!date=2026-09-13

[Script]
# 1. 自动监听与触发：打开 APP 自动拦截、自动提取凭据与手机号，并立即执行签到与话费流量查询
http-request ^https?:\/\/((client|apm|h)\.app\.coc\.10086\.cn\/biz-orange\/|wx\.10086\.cn\/(qwhdsso\/appTokenLogin|qwhdhub\/api\/mark\/)) script-path=https://raw.githubusercontent.com/Jane-Rui/loon/main/Plugin/10086.js, requires-body=true, timeout=30, tag=中国移动自动签到, img-url=https://raw.githubusercontent.com/Jane-Rui/loon/main/Icon/App/10086.png

# 2. 独立手动签到：可在 Loon 脚本列表中随时点击「运行」，直接复用沙盒凭据与手机号执行签到查询（无需任何参数）
generic script-path=https://raw.githubusercontent.com/Jane-Rui/loon/main/Plugin/10086.js, timeout=60, tag=中国移动手动签到, img-url=https://raw.githubusercontent.com/Jane-Rui/loon/main/Icon/App/10086.png

[MITM]
hostname = *.app.coc.10086.cn, wx.10086.cn
